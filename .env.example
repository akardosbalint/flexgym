# Postgres connection string (Vercel Postgres, Neon, Supabase, or any
# standard Postgres provider all work — Prisma connects via `pg`).
DATABASE_URL="postgresql://user:password@host:5432/forgegym"

# Only needed if DATABASE_URL goes through a connection pooler (e.g.
# Supabase's pooled connection string, port 6543) - `prisma migrate deploy`
# needs a direct, non-pooled connection to take its advisory lock, or it
# hangs indefinitely against a pooler in transaction mode instead of
# failing. On Supabase, copy the "Direct connection" string (port 5432,
# Project Settings → Database → Connection string) here; leave unset for
# providers without a pooler in front of DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/forgegym"

# Public site origin (no trailing slash) — used for canonical URLs, the
# sitemap, robots.txt, and Open Graph/Twitter image URLs. Set this to the
# real production domain once deployed.
NEXT_PUBLIC_SITE_URL="https://forgegym.hu"

# NextAuth — generate a real secret for production with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUSTED_HOST=true

# Transactional email (password reset links, contact form) — sent through a
# Google Workspace mailbox via SMTP. Without these set, emails are logged to
# the server console instead of sent (fine for local dev).
# 1. In the Workspace account (e.g. no-reply@forgegym.hu), turn on 2-Step
#    Verification: https://myaccount.google.com/security
# 2. Create an app password: https://myaccount.google.com/apppasswords
#    (needs 2-Step Verification on first; if it's not offered, the Workspace
#    admin console must allow "Less secure apps"/app passwords for the org).
# 3. GOOGLE_WORKSPACE_EMAIL is the full mailbox address; the app password
#    goes in GOOGLE_WORKSPACE_APP_PASSWORD exactly as shown (spaces removed).
GOOGLE_WORKSPACE_EMAIL="no-reply@forgegym.hu"
GOOGLE_WORKSPACE_APP_PASSWORD="xxxxxxxxxxxxxxxx"
# Only needed for non-Gmail/Workspace SMTP relays; defaults to smtp.gmail.com.
GOOGLE_WORKSPACE_SMTP_HOST="smtp.gmail.com"

# Analytics — optional. Vercel Analytics (@vercel/analytics) works with no
# config when deployed on Vercel. Set this too if you also want GA4;
# both only load after a visitor accepts the "statisztikai cookie-k"
# category in the cookie banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Stripe (test mode) — from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the webhook's signing secret in the
# Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET="whsec_..."
